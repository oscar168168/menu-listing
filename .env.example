# PostgreSQL connection string (local Postgres or hosted Cloud SQL / Neon / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/menu_listing?schema=public"

# Strong random secret for signing HTTP-only session cookies (generate via: openssl rand -hex 32)
AUTH_SECRET="replace-with-64-char-random-hex-secret"

# Public base URL used for QR code generation
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Firebase Storage bucket name for persistent dish/logo uploads on Firebase App Hosting
# e.g. my-firebase-project.firebasestorage.app
# FIREBASE_STORAGE_BUCKET=""
