# Firebase project ID for Cloud Firestore
FIREBASE_PROJECT_ID="menu-listing"

# Random 64-character hex secret used to sign HTTP-only session cookies
AUTH_SECRET="replace-with-openssl-rand-hex-32"

# Public origin used when generating table QR codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local development only (choose ONE):
# 1) Firebase Firestore Emulator:
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
#
# 2) Or path to a downloaded Firebase service account JSON key for live Firestore:
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# Optional: Firebase Storage bucket for persistent dish photo & logo uploads
# FIREBASE_STORAGE_BUCKET="menu-listing.firebasestorage.app"
