# Firebase project ID for Cloud Firestore (Spark free plan)
FIREBASE_PROJECT_ID="menu-listing"

# Random 64-character hex secret used to sign HTTP-only session cookies
AUTH_SECRET="replace-with-openssl-rand-hex-32"

# Public origin used when generating table QR codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production hosting (e.g. Vercel Hobby free tier):
# Paste your Firebase service account JSON (single-line JSON or base64-encoded JSON):
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Local development only (choose ONE):
# 1) Firebase Firestore Emulator:
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
#
# 2) Or path to a local Firebase service account JSON key for live Firestore:
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# Optional (Free tier): Cloudinary URL for persistent image uploads in serverless hosting
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
