generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MENU_ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum VendorMode {
  CART
  LISTING_ONLY
}

enum PricingType {
  FIXED
  WEIGHT_BASED
  MARKET_PRICE
}

enum WeightUnit {
  PER_100G
  PER_500G
  PER_KG
  PER_PIECE
  PER_PORTION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MENU_ADMIN)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([role])
}

model Tenant {
  id               String         @id @default(cuid())
  name             String
  nameKm           String?
  nameEn           String?
  slug             String         @unique
  status           TenantStatus   @default(ACTIVE)
  vendorMode       VendorMode     @default(CART)
  logoUrl          String?
  coverUrl         String?
  currency         String         @default("USD") // Primary currency: USD or KHR
  showDualCurrency Boolean        @default(true)
  exchangeRate     Int            @default(4100)
  khrRounding      Int            @default(100) // 100 or 500 KHR
  primaryColor     String         @default("#18181B")
  metaJson         Json           @default("{}")
  users            User[]
  categories       Category[]
  menuItems        MenuItem[]
  cookingStyles    CookingStyle[]
  scanEvents       ScanEvent[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([slug])
  @@index([status])
}

model CookingStyle {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nameKm           String?
  nameEn           String?
  defaultSurcharge Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, sortOrder])
}

model Category {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  nameKm    String?
  nameEn    String?
  sortOrder Int        @default(0)
  isVisible Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tenantId, sortOrder])
  @@index([tenantId, isVisible])
}

model MenuItem {
  id                String      @id @default(cuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId        String
  category          Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name              String
  nameKm            String?
  nameEn            String?
  description       String      @default("")
  descriptionKm     String?
  descriptionEn     String?
  pricingType       PricingType @default(FIXED)
  weightUnit        WeightUnit?
  priceDecimal      Decimal     @default(0) @db.Decimal(12, 2)
  marketPriceMin    Decimal?    @db.Decimal(12, 2)
  marketPriceMax    Decimal?    @db.Decimal(12, 2)
  variantsJson      Json?
  cookingStylesJson Json?
  imageUrl          String?
  tags              String[]    @default([])
  isAvailable       Boolean     @default(true)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([tenantId, categoryId, sortOrder])
  @@index([tenantId, isAvailable])
  @@index([tenantId, sortOrder])
}

model ScanEvent {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tableCode String?
  userAgent String?
  scannedAt DateTime @default(now())

  @@index([tenantId, scannedAt])
  @@index([tenantId, tableCode])
}
